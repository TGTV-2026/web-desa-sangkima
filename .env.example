# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=db_websangkima

EMAIL_MODE=smtp
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1h

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx
# Harus domain yang sudah diverifikasi di Resend (atau onboarding@resend.dev untuk testing)
RESEND_FROM_EMAIL=E-Surat Desa Sangkima <esurat@resend.dev>

# Optional: API Base URL (for production)
# NEXT_PUBLIC_API_URL=http://localhost:3000

NEXT_PUBLIC_APP_URL=your-frontend-url-here